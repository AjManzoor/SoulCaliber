<Window x:Class="SoulCaliberStudio.StatusEffectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dialogue choice — relationship status changes"
        Width="850" Height="570" MinWidth="660" MinHeight="470" WindowStartupLocation="CenterOwner"
        Closing="Window_Closing"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource ForegroundBrush}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="RELATIONSHIP STATUS OUTCOMES" FontSize="20" FontWeight="Bold"/>
      <TextBlock Text="A success or failure can set Ally, Enemy, Neutral or any active status. This does not change Trust, Respect or success probability."
                 Foreground="#B9C9E4" TextWrapping="Wrap" Margin="0,5,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <TextBlock x:Name="StatusMessage" Text="Choose a status effect or create a new one."
                 Foreground="#B9C9E4" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <WrapPanel>
        <Button Content="New effect" Click="New_Click"/>
        <Button Content="Save effect" Click="Save_Click"/>
        <Button Content="Delete selected" Click="Delete_Click"/>
        <Button Content="Close" Click="Close_Click" MinWidth="95"/>
      </WrapPanel>
    </StackPanel>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <ListBox x:Name="EffectList" SelectionChanged="EffectList_SelectionChanged"/>
      <Border Grid.Row="1" Background="#242C39" CornerRadius="6" Padding="12" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="EDIT STATUS CHANGE" FontWeight="Bold" Margin="0,0,0,8"/>
          <WrapPanel>
            <StackPanel Width="170" Margin="0,0,10,8">
              <TextBlock Text="When" Foreground="#B9C9E4"/>
              <ComboBox x:Name="OutcomeBox" SelectionChanged="Editor_Changed"/>
            </StackPanel>
            <StackPanel Width="280" Margin="0,0,10,8">
              <TextBlock Text="Direction" Foreground="#B9C9E4"/>
              <ComboBox x:Name="DirectionBox" SelectionChanged="Editor_Changed"/>
            </StackPanel>
            <StackPanel Width="180" Margin="0,0,10,8">
              <TextBlock Text="New status" Foreground="#B9C9E4"/>
              <ComboBox x:Name="StatusBox" DisplayMemberPath="Name" SelectedValuePath="Key"
                        SelectionChanged="Editor_Changed"/>
            </StackPanel>
          </WrapPanel>
          <TextBlock Text="Initiator → Recipient changes the initiator's view; Recipient → Initiator changes the recipient's view. Both directions applies the same status twice."
                     Foreground="#B9C9E4" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
