<Window x:Class="SoulCaliberStudio.ConditionalDialogueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conditional Dialogue — Phase 7" Width="1140" Height="830"
        MinWidth="900" MinHeight="650" WindowStartupLocation="CenterOwner"
        Closing="Window_Closing" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}">
  <Grid Margin="15">
    <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
      <TextBlock x:Name="Heading" FontSize="20" FontWeight="Bold"/>
      <TextBlock Text="Conditional variants override matching standard lines; standard lines remain as fallbacks. All conditions in a variant must pass."
                 Foreground="#BBC9E1" TextWrapping="Wrap" Margin="0,5,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Grid.Column="0" Background="#242C39" CornerRadius="7" Padding="10" Margin="0,0,12,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="VARIANT TYPE" FontWeight="Bold"/>
          <ComboBox x:Name="KindBox" SelectionChanged="Kind_Changed" Margin="0,6,0,12">
            <ComboBoxItem Content="Introduction"/><ComboBoxItem Content="Phrase / reply"/>
          </ComboBox>
          <TextBlock Text="SAVED VARIANTS" FontWeight="Bold" Margin="0,0,0,6"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
          <Button Content="New conditional variant" Click="New_Click"/>
          <Button Content="Delete selected variant" Click="Delete_Click" Margin="0,5,0,0"/>
        </StackPanel>
        <ListBox x:Name="VariantList" SelectionChanged="Variant_SelectionChanged"/>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="EDIT CONDITIONAL VARIANT" FontSize="16" FontWeight="Bold"/>
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,8,0"><TextBlock Text="Speaking character (blank = any)"/><ComboBox x:Name="SpeakerBox" Margin="0,4,0,0"/></StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Other character (blank = any)"/><ComboBox x:Name="OtherBox" Margin="0,4,0,0"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Priority (0–1000)"/><TextBox x:Name="PriorityBox" Text="0" Margin="0,4,0,0"/></StackPanel>
        </Grid>
        <StackPanel x:Name="OutcomePanel" Margin="0,8,0,0">
          <TextBlock Text="Outcome"/>
          <ComboBox x:Name="OutcomeBox" Margin="0,4,0,0">
            <ComboBoxItem Content="ANY"/><ComboBoxItem Content="SUCCESS"/><ComboBoxItem Content="FAILURE"/>
          </ComboBox>
        </StackPanel>
        <TextBlock Text="Dialogue text" Margin="0,10,0,2"/>
        <TextBox x:Name="PhraseBox" Height="88" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <StackPanel x:Name="ImagePanel" Margin="0,8,0,0">
          <TextBlock Text="Optional phrase image path (res://...)"/>
          <TextBox x:Name="ImageBox" Margin="0,3,0,0"/>
        </StackPanel>
        <Separator Margin="0,12,0,10"/>
        <TextBlock Text="ALL OF THESE RELATIONSHIP CONDITIONS MUST MATCH" FontWeight="Bold"/>
        <TextBlock Text="For an introduction the speaker is the partner (right). Leave either or both character fields blank for any character. PARTNER_TO_ACTOR checks how the partner feels about the actor."
                   Foreground="#BBC9E1" FontSize="11" Margin="0,4,0,8" TextWrapping="Wrap"/>
        <TextBlock Text="Enter a condition below, or select an existing one to edit it." Margin="0,0,0,5"/>
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,7,0"><TextBlock Text="Direction"/><ComboBox x:Name="DirectionBox" Margin="0,4,0,0"/></StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,7,0"><TextBlock Text="Attribute"/><ComboBox x:Name="AttributeBox" Margin="0,4,0,0"/></StackPanel>
          <StackPanel Grid.Column="2" Margin="0,0,7,0"><TextBlock Text="Min"/><TextBox x:Name="MinimumBox" Margin="0,4,0,0"/></StackPanel>
          <StackPanel Grid.Column="3"><TextBlock Text="Max"/><TextBox x:Name="MaximumBox" Margin="0,4,0,0"/></StackPanel>
        </Grid>
        <WrapPanel Margin="0,4,0,5">
          <Button Content="Add condition" Click="AddCondition_Click"/>
          <Button Content="Update selected condition" Click="UpdateCondition_Click"/>
          <Button Content="Remove selected condition" Click="RemoveCondition_Click"/>
        </WrapPanel>
        <ListBox x:Name="ConditionsList" Height="92" SelectionChanged="ConditionsList_SelectionChanged"/>
        <Button Content="Save variant and conditions" FontWeight="Bold" Click="Save_Click"
                HorizontalAlignment="Left" Margin="0,8,0,8"/>
        <Separator Margin="0,10,0,12"/>
        <TextBlock Text="PREVIEW WITH SIMULATED RELATIONSHIPS" FontWeight="Bold" FontSize="15"/>
        <TextBlock Text="These test numbers only affect this preview. They do not touch player saves."
                   FontSize="11" Foreground="#BBC9E1" Margin="0,4,0,6"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,8,0"><TextBlock Text="Actor (left)"/><ComboBox x:Name="PreviewActorBox" Margin="0,4,0,0"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="Partner (right)"/><ComboBox x:Name="PreviewPartnerBox" Margin="0,4,0,0"/></StackPanel>
        </Grid>
        <TextBlock Text="ACTOR_TO_PARTNER — how actor feels about partner" Margin="0,10,0,3"/>
        <UniformGrid x:Name="ActorStatsPanel" Columns="6"/>
        <TextBlock Text="PARTNER_TO_ACTOR — how partner feels about actor" Margin="0,10,0,3"/>
        <UniformGrid x:Name="PartnerStatsPanel" Columns="6"/>
        <Button Content="Preview saved dialogue using these relationship values" Click="Preview_Click" HorizontalAlignment="Left" Margin="0,11,0,7"/>
        <Border Background="#151923" CornerRadius="6" Padding="10">
          <TextBlock x:Name="PreviewResult" TextWrapping="Wrap" Text="The preview will explain which phrase was selected."/>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click"/>
      <TextBlock x:Name="Status" Foreground="#B9C9E4" TextWrapping="Wrap" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</Window>
