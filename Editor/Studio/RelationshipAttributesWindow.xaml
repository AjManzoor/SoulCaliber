<Window x:Class="SoulCaliberStudio.RelationshipAttributesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relationship Attribute Catalogue" Height="790" Width="1130" MinWidth="900" MinHeight="660"
        WindowStartupLocation="CenterOwner" Background="#151A25" Foreground="#F5F7FD">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button"><Setter Property="Margin" Value="0,3,8,3"/><Setter Property="Padding" Value="12,9"/><Setter Property="Background" Value="#354E70"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#57749D"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,3,8,10"/></Style>
  </Window.Resources>
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="RELATIONSHIP ATTRIBUTES" FontSize="25" FontWeight="Bold"/>
      <TextBlock Text="Stable keys drive every condition, effect, formula and saved relationship. Names, icons, ranges and sort order are configurable. Changes to existing keys are deliberately blocked."
                 Foreground="#AFCAE7" FontSize="13" Margin="0,7,0,0"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" x:Name="Status" Text="Open the catalogue to edit relationships." TextWrapping="Wrap" Foreground="#9CC8FA" Margin="0,8,0,2"/>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0" Margin="0,0,14,0">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,9,0,0">
          <Button Content="New relationship attribute" Click="New_Click"/>
          <Button Content="Delete selected (only if unused)" Click="Delete_Click"/>
        </StackPanel>
        <ListBox x:Name="AttributeList" Background="#202939" Foreground="White" BorderBrush="#597090"
                 SelectionChanged="AttributeList_SelectionChanged" FontSize="15" Padding="6"/>
      </DockPanel>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="6,0,6,0">
          <TextBlock Text="EDIT ATTRIBUTE" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/>
          <TextBlock Text="Stable key (cannot change after saving)" Foreground="#B9C9E4"/>
          <TextBox x:Name="KeyBox"/>
          <TextBlock Text="Display name" Foreground="#B9C9E4"/>
          <TextBox x:Name="NameBox"/>
          <TextBlock Text="Description" Foreground="#B9C9E4"/>
          <TextBox x:Name="DescriptionBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"><TextBlock Text="Minimum" Foreground="#B9C9E4"/><TextBox x:Name="MinimumBox"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="Maximum" Foreground="#B9C9E4"/><TextBox x:Name="MaximumBox"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Default" Foreground="#B9C9E4"/><TextBox x:Name="DefaultBox"/></StackPanel>
          </Grid>
          <TextBlock Text="Icon resource path (Godot res://)" Foreground="#B9C9E4"/>
          <TextBox x:Name="IconBox"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"><TextBlock Text="Colour (#RRGGBB)" Foreground="#B9C9E4"/><TextBox x:Name="ColorBox"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="Sort order" Foreground="#B9C9E4"/><TextBox x:Name="OrderBox"/></StackPanel>
          </Grid>
          <CheckBox x:Name="ActiveBox" Content="Active (available in dialogue editors and displayed in Godot)"
                    IsChecked="True" Margin="0,5,0,13"/>
          <TextBlock Foreground="#AFC5E4" FontSize="12" Margin="0,5,0,12"
                     Text="Deleting or disabling a referenced attribute is blocked. Changing a range affects future relationship changes; values already saved in a game are clamped on load. Create new icon files in Godot before publishing."/>
          <Button Content="Save attribute" HorizontalAlignment="Left" FontWeight="Bold" Click="Save_Click"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
