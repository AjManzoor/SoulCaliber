<Window x:Class="SoulCaliberStudio.SpecialEncountersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Special Encounters — Memory-Aware Rules" Width="1130" Height="840"
        MinWidth="860" MinHeight="630" WindowStartupLocation="CenterOwner"
        Background="#152033" Foreground="White">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Margin" Value="0,4,9,10"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Background" Value="#202939"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#597090"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="0,4,9,10"/>
      <Setter Property="Padding" Value="7,6"/>
      <Setter Property="Background" Value="#E6EBF2"/>
      <Setter Property="Foreground" Value="#192236"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="Margin" Value="0,3,8,3"/>
      <Setter Property="Background" Value="#284268"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#587DA8"/>
    </Style>
  </Window.Resources>
  <DockPanel Margin="22">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <StackPanel>
      <TextBlock Text="SPECIAL ENCOUNTERS" FontSize="25" FontWeight="Bold"/>
      <TextBlock Text="Link dialogue to conditional encounters. A memory anchor can power different first-party and third-party reactions."
                 Foreground="#AFC5E4" FontSize="13" Margin="0,7,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </DockPanel>
    <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Foreground="#9CC8FA"
               Margin="0,10,0,2" TextWrapping="Wrap"
               Text="Create an inactive draft, save it, configure conditions, then activate."/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="315"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0" Margin="0,0,15,0">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
          <Button Content="New special encounter" Click="New_Click"/>
          <Button Content="Delete selected encounter" Click="Delete_Click"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="AUTHORED ENCOUNTERS" FontWeight="Bold" Margin="0,0,0,9"/>
        <ListBox x:Name="EncounterList" Background="#202939" Foreground="White"
                 BorderBrush="#597090" FontSize="14" Padding="5"
                 SelectionChanged="EncounterList_SelectionChanged"/>
      </DockPanel>
      <DockPanel Grid.Column="1" LastChildFill="True">
        <!-- Keep both actions visible below the scrolling encounter definition. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="4,10,12,0">
          <Button Content="Save encounter definition" Click="Save_Click" FontWeight="Bold"
                  HorizontalAlignment="Left"/>
          <Button Content="Close" Click="Close_Click" Width="100" Margin="10,3,0,3"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="4,0,12,0">
          <TextBlock Text="ENCOUNTER DEFINITION" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
          <TextBlock Text="Stable encounter key (cannot be changed later)" Foreground="#B9C9E4"/>
          <TextBox x:Name="KeyBox"/>
          <TextBlock Text="Display title" Foreground="#B9C9E4"/>
          <TextBox x:Name="TitleBox"/>
          <TextBlock Text="Existing dialogue interaction" Foreground="#B9C9E4"/>
          <ComboBox x:Name="InteractionBox"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Recipient — any or specific character" Foreground="#B9C9E4"/>
              <ComboBox x:Name="RecipientBox"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Initiator — optional character restriction" Foreground="#B9C9E4"/>
              <ComboBox x:Name="InitiatorBox"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="Any recipient makes the encounter eligible for every approached character, subject to its conditions. Use dialogue written for any character, or author character-specific variants."
                     Foreground="#AFC5E4" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Launch behaviour" Foreground="#B9C9E4"/>
              <ComboBox x:Name="LaunchBox"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Repetition" Foreground="#B9C9E4"/>
              <ComboBox x:Name="RepetitionBox" SelectionChanged="RepetitionBox_SelectionChanged"/>
            </StackPanel>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Priority (0–1000)" Foreground="#B9C9E4"/>
              <TextBox x:Name="PriorityBox"/>
            </StackPanel>
            <CheckBox Grid.Column="1" x:Name="ActiveBox" Content="Active (ready for the runtime selector)"
                      VerticalAlignment="Center" IsChecked="False" Margin="8,0,0,0" Foreground="White"/>
          </Grid>
          <Separator Margin="0,7,0,12"/>
          <TextBlock Text="MEMORY ANCHOR (OPTIONAL EXCEPT ONCE PER OCCURRENCE)" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
          <TextBlock Text="Bind a matching historical incident for dialogue placeholders and relationship checks. Once-per-occurrence also uses it for completion tracking."
                     Foreground="#AFC5E4" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <TextBlock Text="Memory type to acknowledge" Foreground="#B9C9E4"/>
          <ComboBox x:Name="AnchorMemoryBox" SelectionChanged="AnchorMemoryBox_SelectionChanged"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Actor" Foreground="#B9C9E4"/>
              <ComboBox x:Name="AnchorActorBox"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Affected" Foreground="#B9C9E4"/>
              <ComboBox x:Name="AnchorAffectedBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Knower" Foreground="#B9C9E4"/>
              <ComboBox x:Name="AnchorKnowerBox"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="THIRD-PARTY RELATIONSHIP TO THE MEMORY'S AFFECTED CHARACTER" FontWeight="Bold" Margin="0,6,0,4"/>
          <TextBlock Text="Require Recipient → a character affected by this SAME anchored memory to have a particular status. Leave empty for direct-victim encounters. If multiple people were affected, the matched person is bound to {affected}."
                     Foreground="#AFC5E4" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <ComboBox x:Name="AffectedStatusBox"/>
          <TextBlock Text="Placeholders in this linked dialogue: {affected}, {memory.actor}, {initiator}, {recipient}. Direct encounters can set Anchor Affected = Recipient. Existing {actor}/{partner} remain valid."
                     Foreground="#AFC5E4" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,7"/>
          <Separator Margin="0,7,0,12"/>
          <TextBlock Text="ELIGIBILITY CONDITIONS" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
          <TextBlock Text="Use the existing memory/status AND, OR and NOT editor. Its Initiator/Recipient references refer to the characters in this encounter."
                     Foreground="#AFC5E4" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,7"/>
          <Button x:Name="ConditionsButton" Content="Configure AND / OR / NOT conditions — None"
                  Click="EditConditions_Click" HorizontalAlignment="Stretch"/>
          <TextBlock Text="Save an inactive draft before editing conditions. Active encounters must have a valid condition tree."
                     Foreground="#AFC5E4" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,12"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
