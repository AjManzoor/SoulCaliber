<Window x:Class="SoulCaliberStudio.ConversationAvailabilityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dialogue Availability — Phase 13E-4A" Width="1070" Height="790"
        MinWidth="800" MinHeight="570" WindowStartupLocation="CenterOwner"
        Background="#152033" Foreground="White">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Margin" Value="0,4,9,10"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Background" Value="#202939"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#597090"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="0,4,9,10"/>
      <Setter Property="Padding" Value="7,6"/>
      <Setter Property="Background" Value="#E6EBF2"/>
      <Setter Property="Foreground" Value="#192236"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="Margin" Value="0,3,8,3"/>
      <Setter Property="Background" Value="#284268"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#587DA8"/>
    </Style>
  </Window.Resources>
  <DockPanel Margin="22">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="NORMAL CONVERSATION AVAILABILITY" FontSize="23" FontWeight="Bold"/>
      <TextBlock Text="Select an existing dialogue, then configure when and for whom it appears. One dialogue can have several independent availability rules. Godot selection follows in 13E-4B."
                 Foreground="#AFC5E4" FontSize="13" Margin="0,7,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Foreground="#9CC8FA"
               Margin="0,10,0,2" TextWrapping="Wrap"
               Text="Select a dialogue on the left, then create or edit an availability rule."/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="310"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0" Margin="0,0,16,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="2*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="EXISTING DIALOGUE INTERACTIONS" FontWeight="Bold" Margin="0,0,0,9"/>
        <ListBox Grid.Row="1" x:Name="DialogueList" Background="#202939" Foreground="White"
                 BorderBrush="#597090" FontSize="14" Padding="5"
                 SelectionChanged="DialogueList_SelectionChanged"/>
        <TextBlock Grid.Row="2" Text="AVAILABILITY RULES FOR SELECTED DIALOGUE"
                   FontWeight="Bold" TextWrapping="Wrap" Margin="0,13,0,9"/>
        <ListBox Grid.Row="3" x:Name="TopicList" Background="#202939" Foreground="White"
                 BorderBrush="#597090" FontSize="13" Padding="5"
                 SelectionChanged="TopicList_SelectionChanged"/>
        <StackPanel Grid.Row="4" Margin="0,10,0,0">
          <Button Content="Add availability rule" Click="New_Click"/>
          <Button Content="Delete selected rule" Click="Delete_Click"/>
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,0,12,0">
          <TextBlock Text="AVAILABILITY RULE" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
          <TextBlock Text="Internal rule key (generated automatically)" Foreground="#B9C9E4"/>
          <TextBox x:Name="KeyBox" IsReadOnly="True" Background="#263347"/>
          <TextBlock Text="Conversation menu title (defaults to dialogue title)" Foreground="#B9C9E4"/>
          <TextBox x:Name="TitleBox"/>
          <TextBlock Text="Linked dialogue" Foreground="#B9C9E4"/>
          <TextBlock x:Name="LinkedDialogueText" Margin="0,7,0,15" Foreground="#DCE9FC" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Recipient — approached character" Foreground="#B9C9E4"/>
              <ComboBox x:Name="RecipientBox"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Initiator — approaching character" Foreground="#B9C9E4"/>
              <ComboBox x:Name="InitiatorBox"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="Both fields can be Any. For a character-specific dialogue, restrict the recipient to avoid offering it to the wrong person."
                     TextWrapping="Wrap" Foreground="#AFC5E4" FontSize="12" Margin="0,0,0,12"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Display order (0–10000)" Foreground="#B9C9E4"/>
              <TextBox x:Name="OrderBox"/>
            </StackPanel>
            <CheckBox Grid.Column="1" x:Name="ActiveBox" Content="Active — can appear in the conversation list"
                      VerticalAlignment="Center" IsChecked="False" Margin="8,0,0,0" Foreground="White"/>
          </Grid>
          <TextBlock Text="Lower display-order values appear earlier. Inactive drafts are retained but will not be shown in the game."
                     Foreground="#AFC5E4" FontSize="12" TextWrapping="Wrap"/>
          <Separator Margin="0,17,0,14"/>
          <TextBlock Text="OPTIONAL ELIGIBILITY CONDITIONS" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
          <TextBlock Text="Leave conditions empty to make this topic available to its permitted characters. Or use the existing memory/status AND, OR and NOT builder. Initiator and Recipient in conditions refer to this conversation's current participants."
                     Foreground="#AFC5E4" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <Button x:Name="ConditionsButton" Content="Configure AND / OR / NOT conditions — None"
                  Click="EditConditions_Click" HorizontalAlignment="Stretch"/>
          <TextBlock Text="Save the topic before editing its conditions. Normal conversations remain repeatable; special encounters retain their separate completion rules."
                     Foreground="#AFC5E4" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,12"/>
          <Button Content="Save availability rule" Click="Save_Click" FontWeight="Bold"
                  HorizontalAlignment="Left" Margin="0,9,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
