<Window x:Class="SoulCaliberStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoulCaliber Studio — Content Editor" Height="850" Width="1420" MinWidth="960" MinHeight="620"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource ForegroundBrush}"
        FontFamily="Segoe UI" FontSize="13"
        Loaded="Window_Loaded" Closing="Window_Closing">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="SoulCaliber Studio" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Text="Offline content authoring • editing the master SQLite database • Godot stays read-only" Foreground="#BAC3D4" Margin="0,1,0,12"/>
      <Border Padding="10" Background="#222836" CornerRadius="8">
        <DockPanel>
          <Button Content="Open master database..." Click="Open_Click" DockPanel.Dock="Right" />
          <Button Content="Create safety backup" Click="Backup_Click" DockPanel.Dock="Right" />
          <TextBlock x:Name="PathText" VerticalAlignment="Center" Text="No database loaded" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Border>
    </StackPanel>
    <TabControl x:Name="WorkspaceTabs" Margin="0,14,0,0" SelectionChanged="WorkspaceTabs_SelectionChanged">
      <TabItem Header="Dialogue Designer" Padding="12,6">
        <Grid Margin="5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Interaction browser -->
          <Border Grid.Column="0" Background="#242C39" CornerRadius="7" Padding="10" Margin="0,0,7,0">
            <DockPanel>
              <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock Text="INTERACTION" FontWeight="SemiBold" Foreground="#B9C9E4" Margin="0,5"/>
                <TextBlock Text="Key (immutable after creation)" FontSize="11" Foreground="#B9C9E4"/>
                <TextBox x:Name="InteractionKeyBox" Margin="0,2,0,6" TextChanged="DesignerField_Changed"/>
                <TextBlock Text="Title" FontSize="11" Foreground="#B9C9E4"/>
                <TextBox x:Name="InteractionTitleBox" Margin="0,2,0,6" TextChanged="DesignerField_Changed"/>
                <TextBlock Text="Host character" FontSize="11" Foreground="#B9C9E4"/>
                <ComboBox x:Name="InteractionHostBox" Margin="0,2,0,6" SelectionChanged="DesignerField_Changed"/>
                <TextBlock Text="Starting node key" FontSize="11" Foreground="#B9C9E4"/>
                <TextBox x:Name="InteractionStartBox" Margin="0,2,0,6" TextChanged="DesignerField_Changed"/>
                <WrapPanel>
                  <Button Content="New" Click="NewInteraction_Click"/>
                  <Button Content="Save" Click="SaveInteraction_Click"/>
                  <Button Content="Delete" Click="DeleteInteraction_Click"/>
                </WrapPanel>
              </StackPanel>
              <TextBlock DockPanel.Dock="Top" Text="INTERACTION TYPES" FontWeight="Bold" Margin="0,0,0,8"/>
              <ListBox x:Name="InteractionList" SelectionChanged="InteractionList_SelectionChanged"/>
            </DockPanel>
          </Border>

          <!-- Node browser -->
          <Border Grid.Column="1" Background="#242C39" CornerRadius="7" Padding="10" Margin="0,0,7,0">
            <DockPanel>
              <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock Text="DIALOGUE NODE / ROUND" FontWeight="SemiBold" Foreground="#B9C9E4" Margin="0,5"/>
                <TextBlock Text="Node key" FontSize="11" Foreground="#B9C9E4"/>
                <TextBox x:Name="NodeKeyBox" Margin="0,2,0,6" TextChanged="DesignerField_Changed"/>
                <StackPanel Orientation="Horizontal">
                  <StackPanel Width="110"><TextBlock Text="Round" FontSize="11" Foreground="#B9C9E4"/><TextBox x:Name="NodeRoundBox" Text="1" TextChanged="DesignerField_Changed"/></StackPanel>
                  <StackPanel Width="110" Margin="8,0,0,0"><TextBlock Text="Sort order" FontSize="11" Foreground="#B9C9E4"/><TextBox x:Name="NodeOrderBox" Text="0" TextChanged="DesignerField_Changed"/></StackPanel>
                </StackPanel>
                <TextBlock Text="Generic host introduction (fallback)" FontSize="11" Foreground="#B9C9E4" Margin="0,8,0,2"/>
                <TextBox x:Name="NodeIntroBox" Height="86" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextChanged="DesignerField_Changed"/>
                <Button Content="Edit character / pair introductions..." Click="EditIntroductions_Click"
                        Margin="0,8,0,5" HorizontalAlignment="Left"/>
                <TextBlock Text="Each node may override its generic introduction for a speaker or a particular character pairing."
                           Foreground="#B9C9E4" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <WrapPanel Margin="0,5,0,0">
                  <Button Content="New" Click="NewNode_Click"/>
                  <Button Content="Save" Click="SaveNode_Click"/>
                  <Button Content="Delete" Click="DeleteNode_Click"/>
                </WrapPanel>
              </StackPanel>
              <TextBlock DockPanel.Dock="Top" Text="ROUNDS / NODES" FontWeight="Bold" Margin="0,0,0,8"/>
              <ListBox x:Name="NodeList" SelectionChanged="NodeList_SelectionChanged"/>
            </DockPanel>
          </Border>

          <!-- Choice editor + dialogue lines -->
          <Grid Grid.Column="2" Margin="3,0,0,0">
            <Grid.RowDefinitions><RowDefinition Height="145"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <TextBlock Text="CHOICES IN THIS ROUND" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="New choice" Click="NewOption_Click" Margin="14,0,0,3"/>
                <Button Content="Delete choice" Click="DeleteOption_Click"/>
              </StackPanel>
              <ListBox x:Name="OptionList" SelectionChanged="OptionList_SelectionChanged"/>
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
              <StackPanel Margin="0,0,10,0">
                <TextBlock Text="CHOICE EDITOR" FontWeight="Bold" FontSize="16"/>
                <TextBlock Text="Choice key (immutable after creation)" Foreground="#B9C9E4" FontSize="11" Margin="0,8,0,2"/>
                <TextBox x:Name="OptionKeyBox" TextChanged="DesignerField_Changed"/>
                <TextBlock Text="Choice label (shown on button)" Foreground="#B9C9E4" FontSize="11" Margin="0,7,0,2"/>
                <TextBox x:Name="OptionLabelBox" TextChanged="DesignerField_Changed"/>
                <WrapPanel Margin="0,7,0,0">
                  <StackPanel Width="120"><TextBlock Text="Base chance %" Foreground="#B9C9E4" FontSize="11"/><TextBox x:Name="OptionChanceBox" TextChanged="DesignerField_Changed"/></StackPanel>
                  <StackPanel Width="100" Margin="12,0,0,0"><TextBlock Text="Sort order" Foreground="#B9C9E4" FontSize="11"/><TextBox x:Name="OptionOrderBox" TextChanged="DesignerField_Changed"/></StackPanel>
                </WrapPanel>
                <TextBlock Text="Next node on success (blank = finish)" Foreground="#B9C9E4" FontSize="11" Margin="0,7,0,2"/>
                <ComboBox x:Name="OptionSuccessNextBox" IsEditable="True" SelectionChanged="DesignerField_Changed"/>
                <TextBlock Text="Next node on failure (blank = finish)" Foreground="#B9C9E4" FontSize="11" Margin="0,7,0,2"/>
                <ComboBox x:Name="OptionFailureNextBox" IsEditable="True" SelectionChanged="DesignerField_Changed"/>
                <TextBlock Text="Generic player phrase" Foreground="#B9C9E4" FontSize="11" Margin="0,7,0,2"/>
                <TextBox x:Name="OptionPlayerLineBox" Height="65" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="DesignerField_Changed"/>
                <TextBlock Text="Generic host reply on SUCCESS" Foreground="#B9C9E4" FontSize="11" Margin="0,7,0,2"/>
                <TextBox x:Name="OptionHostSuccessBox" Height="65" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="DesignerField_Changed"/>
                <TextBlock Text="Generic host reply on FAILURE" Foreground="#B9C9E4" FontSize="11" Margin="0,7,0,2"/>
                <TextBox x:Name="OptionHostFailureBox" Height="65" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="DesignerField_Changed"/>
                <TextBlock Text="Target reaction on success" Foreground="#B9C9E4" FontSize="11" Margin="0,7,0,2"/>
                <TextBox x:Name="OptionSuccessReactionBox" TextChanged="DesignerField_Changed"/>
                <TextBlock Text="Target reaction on failure" Foreground="#B9C9E4" FontSize="11" Margin="0,7,0,2"/>
                <TextBox x:Name="OptionFailureReactionBox" TextChanged="DesignerField_Changed"/>
                <Button Content="Save choice and generic dialogue" Click="SaveOption_Click" Margin="0,10" FontWeight="Bold"/>
                <Button Content="Edit choice mechanics..."
                        Click="EditChoiceMechanics_Click" HorizontalAlignment="Left" Margin="0,3,0,4"/>
                <TextBlock x:Name="MechanicsSummaryText" Text="Save a choice to configure its mechanics."
                           Foreground="#9EC5FF" TextWrapping="Wrap" FontSize="11" Margin="2,2,0,7"/>
                <Separator Margin="0,12,0,8"/>
                <TextBlock Text="CHARACTER-SPECIFIC PHRASES" FontWeight="Bold" FontSize="15"/>
                <Button Content="Preview dialogue for any two characters..." Click="PreviewDialogue_Click"
                        Margin="0,6,0,6" HorizontalAlignment="Left"/>
                <TextBlock Text="Overrides generic dialogue for this choice. Outcome ANY matches both outcomes." TextWrapping="Wrap" Foreground="#B9C9E4" FontSize="11"/>
                <ListBox x:Name="LineList" Height="115" Margin="0,6" SelectionChanged="LineList_SelectionChanged"/>
                <TextBlock Text="Use New phrase to add another character. Existing speaker / other character / outcome cannot be changed." TextWrapping="Wrap" Foreground="#B9C9E4" FontSize="11" Margin="0,6"/>
                <TextBlock Text="Speaking character" Foreground="#B9C9E4" FontSize="11"/>
                <ComboBox x:Name="LineCharacterBox" SelectionChanged="DesignerField_Changed"/>
                <TextBlock Text="Other character (blank = any)" Foreground="#B9C9E4" FontSize="11" Margin="0,6,0,0"/>
                <ComboBox x:Name="LineVisitorBox" SelectionChanged="DesignerField_Changed"/>
                <TextBlock Text="Outcome" Foreground="#B9C9E4" FontSize="11" Margin="0,6,0,0"/>
                <ComboBox x:Name="LineOutcomeBox" SelectionChanged="DesignerField_Changed">
                  <ComboBoxItem Content="ANY"/><ComboBoxItem Content="SUCCESS"/><ComboBoxItem Content="FAILURE"/>
                </ComboBox>
                <TextBlock Text="Dialogue phrase" Foreground="#B9C9E4" FontSize="11" Margin="0,6,0,0"/>
                <TextBox x:Name="LineTextBox" Height="86" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="DesignerField_Changed"/>
                <TextBlock Text="Optional image path (res://...)" Foreground="#B9C9E4" FontSize="11" Margin="0,6,0,0"/>
                <TextBox x:Name="LineImageBox" TextChanged="DesignerField_Changed"/>
                <WrapPanel Margin="0,8,0,0">
                  <Button Content="New phrase" Click="NewLine_Click"/>
                  <Button Content="Save phrase" Click="SaveLine_Click"/>
                  <Button Content="Delete phrase" Click="DeleteLine_Click"/>
                </WrapPanel>
                <TextBlock Text="Advanced Tables is still available for inspecting raw database records." Foreground="#B9C9E4" TextWrapping="Wrap" Margin="0,12" FontSize="11"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
          <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <Button Content="Validate selected interaction" DockPanel.Dock="Right" Click="ValidateInteraction_Click"/>
            <TextBlock x:Name="DesignerStatus" Text="Open the master database to begin." Foreground="#B9C9E4" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </DockPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Characters &amp; Portraits" Padding="12,6">
        <Grid Margin="6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Roster -->
          <Border Grid.Column="0" Background="#242C39" CornerRadius="7" Padding="12" Margin="0,0,8,0">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="CHARACTER ROSTER" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBox x:Name="CharacterSearchBox" Height="30" TextChanged="CharacterSearch_Changed"
                         ToolTip="Filter characters by name or ID"/>
              </StackPanel>
              <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <WrapPanel>
                  <Button Content="New character" Click="NewCharacter_Click"/>
                  <Button Content="Delete" Click="DeleteCharacter_Click"/>
                </WrapPanel>
                <TextBlock Text="Existing IDs remain fixed to protect dialogue references."
                           Foreground="#B9C9E4" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
              </StackPanel>
              <ListBox x:Name="CharacterList" Margin="0,9,0,0" SelectionChanged="CharacterList_SelectionChanged"/>
            </DockPanel>
          </Border>

          <!-- Identity and personality -->
          <Border Grid.Column="1" Background="#242C39" CornerRadius="7" Padding="12" Margin="0,0,8,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="CHARACTER DETAILS" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="Permanent ID (A-Z, 0-9, underscore)" Foreground="#B9C9E4" FontSize="11"/>
                <TextBox x:Name="CharacterIdBox" TextChanged="CharacterField_Changed" Margin="0,3,0,8"/>
                <TextBlock Text="Display name" Foreground="#B9C9E4" FontSize="11"/>
                <TextBox x:Name="CharacterNameBox" TextChanged="CharacterField_Changed" Margin="0,3,0,12"/>
                <Separator Margin="0,2,0,10"/>
                <TextBlock Text="PERSONALITY (0–100)" FontWeight="Bold" Margin="0,0,0,7"/>
                <TextBlock Text="Persuasion" Foreground="#B9C9E4"/>
                <TextBox x:Name="CharPersuasionBox" Margin="0,2,0,6" TextChanged="CharacterField_Changed"/>
                <TextBlock Text="Intimidation" Foreground="#B9C9E4"/>
                <TextBox x:Name="CharIntimidationBox" Margin="0,2,0,6" TextChanged="CharacterField_Changed"/>
                <TextBlock Text="Deception" Foreground="#B9C9E4"/>
                <TextBox x:Name="CharDeceptionBox" Margin="0,2,0,6" TextChanged="CharacterField_Changed"/>
                <TextBlock Text="Charm" Foreground="#B9C9E4"/>
                <TextBox x:Name="CharCharmBox" Margin="0,2,0,6" TextChanged="CharacterField_Changed"/>
                <TextBlock Text="Insight" Foreground="#B9C9E4"/>
                <TextBox x:Name="CharInsightBox" Margin="0,2,0,6" TextChanged="CharacterField_Changed"/>
                <TextBlock Text="Resolve" Foreground="#B9C9E4"/>
                <TextBox x:Name="CharResolveBox" Margin="0,2,0,8" TextChanged="CharacterField_Changed"/>
                <Button Content="Save character &amp; personality" Click="SaveCharacter_Click" FontWeight="Bold" Margin="0,8,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <!-- Portraits and reaction images -->
          <Border Grid.Column="2" Background="#242C39" CornerRadius="7" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,10,0">
                <TextBlock Text="GODOT ARTWORK FOLDER" FontWeight="Bold"/>
                <WrapPanel Margin="0,5,0,0">
                  <Button Content="Locate project.godot..." Click="ChooseGodotProject_Click"/>
                  <Button Content="Check portraits" Click="CheckPortraits_Click"/>
                </WrapPanel>
                <TextBlock x:Name="GodotProjectText" Text="Select your Godot project to enable image previews and imports."
                           Foreground="#B9C9E4" FontSize="11" TextWrapping="Wrap" Margin="2,4,0,7"/>
                <Separator Margin="0,5,0,8"/>
                <TextBlock Text="CORE PORTRAITS" FontWeight="Bold" Margin="0,0,0,7"/>
                <TextBlock Text="Default portrait (res://...)" Foreground="#B9C9E4" FontSize="11"/>
                <DockPanel Margin="0,3,0,6">
                  <Button Content="Browse / Import" DockPanel.Dock="Right" Tag="Default" Click="ImportPortrait_Click"/>
                  <TextBox x:Name="CharDefaultImageBox" TextChanged="CharacterField_Changed"/>
                </DockPanel>
                <TextBlock Text="Success portrait (res://...)" Foreground="#B9C9E4" FontSize="11"/>
                <DockPanel Margin="0,3,0,6">
                  <Button Content="Browse / Import" DockPanel.Dock="Right" Tag="Success" Click="ImportPortrait_Click"/>
                  <TextBox x:Name="CharWinImageBox" TextChanged="CharacterField_Changed"/>
                </DockPanel>
                <TextBlock Text="Failure portrait (res://...)" Foreground="#B9C9E4" FontSize="11"/>
                <DockPanel Margin="0,3,0,7">
                  <Button Content="Browse / Import" DockPanel.Dock="Right" Tag="Failure" Click="ImportPortrait_Click"/>
                  <TextBox x:Name="CharLoseImageBox" TextChanged="CharacterField_Changed"/>
                </DockPanel>
                <WrapPanel Margin="0,2,0,8">
                  <StackPanel Width="142" Margin="0,0,8,0">
                    <TextBlock Text="Default" FontSize="11" Foreground="#B9C9E4"/>
                    <Border Background="#152031" Height="152" BorderBrush="#60728C" BorderThickness="1" CornerRadius="4">
                      <Image x:Name="CharDefaultPreview" Stretch="Uniform"/>
                    </Border>
                  </StackPanel>
                  <StackPanel Width="142" Margin="0,0,8,0">
                    <TextBlock Text="Success" FontSize="11" Foreground="#B9C9E4"/>
                    <Border Background="#152031" Height="152" BorderBrush="#60728C" BorderThickness="1" CornerRadius="4">
                      <Image x:Name="CharWinPreview" Stretch="Uniform"/>
                    </Border>
                  </StackPanel>
                  <StackPanel Width="142">
                    <TextBlock Text="Failure" FontSize="11" Foreground="#B9C9E4"/>
                    <Border Background="#152031" Height="152" BorderBrush="#60728C" BorderThickness="1" CornerRadius="4">
                      <Image x:Name="CharLosePreview" Stretch="Uniform"/>
                    </Border>
                  </StackPanel>
                </WrapPanel>
                <TextBlock x:Name="CorePortraitStatus" Foreground="#B9C9E4" TextWrapping="Wrap" FontSize="11"/>
                <Separator Margin="0,12,0,10"/>
                <TextBlock Text="REACTION PORTRAITS" FontWeight="Bold"/>
                <TextBlock Text="Angry, Amused, Intimidated, Suspicious and any new expression keys."
                           FontSize="11" TextWrapping="Wrap" Foreground="#B9C9E4" Margin="0,3,0,6"/>
                <ListBox x:Name="CharacterReactionList" Height="116" SelectionChanged="CharacterReactionList_SelectionChanged"/>
                <TextBlock Text="Reaction key" Foreground="#B9C9E4" FontSize="11" Margin="0,8,0,2"/>
                <ComboBox x:Name="ReactionKeyBox" IsEditable="True" IsTextSearchEnabled="False" SelectionChanged="ReactionField_Changed"/>
                <TextBlock Text="Image path (res://...)" Foreground="#B9C9E4" FontSize="11" Margin="0,8,0,2"/>
                <DockPanel>
                  <Button Content="Browse / Import" DockPanel.Dock="Right" Tag="Reaction" Click="ImportPortrait_Click"/>
                  <TextBox x:Name="ReactionPathBox" TextChanged="ReactionField_Changed"/>
                </DockPanel>
                <WrapPanel Margin="0,8,0,4">
                  <Button Content="New reaction" Click="NewReaction_Click"/>
                  <Button Content="Save reaction" Click="SaveReaction_Click"/>
                  <Button Content="Delete reaction" Click="DeleteReaction_Click"/>
                </WrapPanel>
                <Border Background="#152031" Height="160" Width="152" HorizontalAlignment="Left"
                        BorderBrush="#60728C" BorderThickness="1" CornerRadius="4">
                  <Image x:Name="ReactionPreview" Stretch="Uniform"/>
                </Border>
                <TextBlock x:Name="ReactionPortraitStatus" Foreground="#B9C9E4" FontSize="11"
                           TextWrapping="Wrap" Margin="0,5,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <TextBlock x:Name="CharacterStatus" Grid.Row="1" Grid.ColumnSpan="3" Margin="4,8,0,0"
                     Foreground="#B9C9E4" Text="Open the master database to edit characters."
                     TextWrapping="Wrap"/>
        </Grid>
      </TabItem>
      <TabItem Header="Advanced Tables" Padding="12,6">
        <DockPanel Margin="5">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Margin="0,14,0,4" Text="CONTENT TABLE" FontWeight="SemiBold" Foreground="#BAC3D4"/>
      <DockPanel>
        <ComboBox x:Name="TableSelector" SelectionChanged="TableSelector_SelectionChanged" Height="30" Width="240" DockPanel.Dock="Left" Margin="0,0,12,0"/>
        <TextBlock Text="Search current table:" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left" />
        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Height="30" VerticalContentAlignment="Center" />
      </DockPanel>
      <TextBlock x:Name="HintText" Margin="0,10,0,10" Foreground="#BAC3D4" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
      <WrapPanel Margin="0,12,0,0">
        <Button Content="Add record" Click="Add_Click"/>
        <Button Content="Delete selected" Click="Delete_Click"/>
        <Button Content="Save changes" Click="Save_Click" FontWeight="Bold"/>
        <Button Content="Discard unsaved changes" Click="Discard_Click"/>
        <Button Content="Check foreign keys" Click="Check_Click"/>
      </WrapPanel>
      <TextBlock x:Name="StatusText" Margin="4,7,0,0" Foreground="#BAC3D4" TextWrapping="Wrap" />
    </StackPanel>
    <Border Background="#F8F9FC" CornerRadius="8" Padding="8">
      <DataGrid x:Name="ContentGrid" AutoGenerateColumns="True" AutoGeneratingColumn="ContentGrid_AutoGeneratingColumn"
                CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                IsReadOnly="False" AlternatingRowBackground="#F0F2F7" Background="White"
                Foreground="#1A2230" GridLinesVisibility="Horizontal" RowHeight="34"
                HeadersVisibility="All" FrozenColumnCount="0">
        <DataGrid.Resources>
          <!-- Override the application's white TextBlock colour inside light grid cells. -->
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1A2230"/>
          </Style>
          <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#1A2230"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CaretBrush" Value="#1A2230"/>
          </Style>
          <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#1A2230"/>
            <Style.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#DCE8FF"/>
                <Setter Property="Foreground" Value="#1A2230"/>
              </Trigger>
            </Style.Triggers>
          </Style>
          <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E4E9F2"/>
            <Setter Property="Foreground" Value="#1A2230"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
          </Style>
          <Style TargetType="DataGridRowHeader">
            <Setter Property="Background" Value="#E4E9F2"/>
            <Setter Property="Foreground" Value="#1A2230"/>
          </Style>
        </DataGrid.Resources>
      </DataGrid>
    </Border>
        </DockPanel>
      </TabItem>
      <TabItem Header="Publishing" Padding="12,6">
        <Grid Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Grid.Column="0" Background="#242C39" CornerRadius="7" Padding="16" Margin="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="CONTENT PUBLISHER" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock Text="Publish a validated snapshot of your master SQLite database, without changing it."
                           Foreground="#B9C9E4" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <TextBlock Text="Master database" FontWeight="SemiBold"/>
                <TextBlock x:Name="PublishMasterText" Foreground="#B9C9E4" TextWrapping="Wrap" Margin="0,4,0,13"
                           Text="Open a master database above first."/>
                <TextBlock Text="Godot game project" FontWeight="SemiBold"/>
                <TextBlock x:Name="PublishGodotText" Foreground="#B9C9E4" TextWrapping="Wrap" Margin="0,4,0,5"
                           Text="Locate project.godot to validate res:// artwork paths."/>
                <Button Content="Locate project.godot..." Click="SelectPublishProject_Click"
                        HorizontalAlignment="Left" Margin="0,0,0,15"/>
                <TextBlock Text="Published output folder" FontWeight="SemiBold"/>
                <DockPanel Margin="0,5,0,14">
                  <Button Content="Browse..." Click="SelectPublishOutput_Click" DockPanel.Dock="Right"/>
                  <TextBox x:Name="PublishOutputBox" VerticalContentAlignment="Center" />
                </DockPanel>
                <TextBlock Text="Content version (unique)" FontWeight="SemiBold"/>
                <TextBox x:Name="PublishVersionBox" Text="0.2.0" Margin="0,5,0,10"/>
                <TextBlock Text="Existing version folders are never overwritten. Choose a new version for every publication."
                           Foreground="#B9C9E4" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,15"/>
                <WrapPanel Margin="0,0,0,10">
                  <Button x:Name="PublishValidateButton" Content="1. Validate content" Click="PublishValidate_Click"/>
                  <Button x:Name="PublishCreateButton" Content="2. Publish package" Click="PublishCreate_Click"/>
                </WrapPanel>
                <Separator Margin="0,10,0,12" />
                <TextBlock Text="INSTALL INTO A GODOT EXPORT" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="First export your Godot Windows .NET project to a folder containing its .exe and .pck. Then copy the published Content folder beside the .exe."
                           Foreground="#B9C9E4" TextWrapping="Wrap" Margin="0,0,0,7"/>
                <Button x:Name="PublishInstallButton" Content="3. Install into exported game..."
                        Click="PublishInstall_Click" IsEnabled="False" HorizontalAlignment="Left"/>
                <TextBlock Text="Keep Godot's export mode set to Export all resources; portrait images are bundled by Godot, not copied into the SQLite sidecar."
                           Foreground="#B9C9E4" FontSize="11" TextWrapping="Wrap" Margin="0,13,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <Border Grid.Column="1" Background="#242C39" CornerRadius="7" Padding="16">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="VALIDATION &amp; PUBLISHING REPORT" FontWeight="SemiBold"
                         Margin="0,0,0,11"/>
              <TextBox x:Name="PublishLogBox" IsReadOnly="True" TextWrapping="Wrap"
                       FontFamily="Consolas" FontSize="12" AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
          </Border>
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="#B9C9E4"
                     Margin="4,9,0,0" Text="Publish creates: Published/vX.Y.Z/Content/content.db + manifest.json. The player's save database stays in Godot user:// and is never included."/>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
