<Window x:Class="SoulCaliberStudio.MemoryCatalogueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Catalogue — Phase 13A" Width="1050" Height="770"
        MinWidth="800" MinHeight="610" WindowStartupLocation="CenterOwner"
        Background="#152033" Foreground="White">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Margin" Value="0,4,8,10"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Background" Value="#202939"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#597090"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="0,4,8,10"/>
      <Setter Property="Padding" Value="7,6"/>
      <Setter Property="Background" Value="#E6EBF2"/>
      <Setter Property="Foreground" Value="#192236"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="Margin" Value="0,3,8,3"/>
      <Setter Property="Background" Value="#284268"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#587DA8"/>
    </Style>
  </Window.Resources>
  <DockPanel Margin="22">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click"
              Width="100" Height="36" Margin="14,0,0,0" VerticalAlignment="Top"/>
      <StackPanel>
      <TextBlock Text="MEMORY CATALOGUE" FontSize="25" FontWeight="Bold"/>
      <TextBlock Text="Author reusable memory tags, defaults and relevant personality traits. This does not record gameplay memories."
                 Foreground="#AFC5E4" FontSize="13" Margin="0,7,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </DockPanel>
    <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText"
               Foreground="#9CC8FA" Margin="0,10,0,2" TextWrapping="Wrap"
               Text="Choose a memory or create a new one."/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="305"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0" Margin="0,0,15,0">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
          <Button Content="New memory type" Click="New_Click"/>
          <Button Content="Delete selected memory" Click="Delete_Click"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="MEMORY TYPES" FontWeight="Bold" Margin="0,0,0,9"/>
        <ListBox x:Name="MemoryList" Background="#202939" Foreground="White"
                 BorderBrush="#597090" FontSize="14" Padding="5"
                 SelectionChanged="MemoryList_SelectionChanged"/>
      </DockPanel>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,0,12,0">
          <TextBlock Text="EDIT MEMORY TYPE" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
          <TextBlock Text="Stable key (immutable after saving)" Foreground="#B9C9E4"/>
          <TextBox x:Name="KeyBox"/>
          <TextBlock Text="Display name" Foreground="#B9C9E4"/>
          <TextBox x:Name="NameBox"/>
          <TextBlock Text="Description" Foreground="#B9C9E4"/>
          <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" Height="77"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Default severity" Foreground="#B9C9E4"/>
              <ComboBox x:Name="SeverityBox" SelectedValuePath="Tag"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Default knowledge" Foreground="#B9C9E4"/>
              <ComboBox x:Name="KnowledgeBox" SelectedValuePath="Tag"/>
            </StackPanel>
          </Grid>
          <Button x:Name="AudienceButton" Content="Configure custom audiences..." Click="Audience_Click"
                  HorizontalAlignment="Left" Margin="0,0,0,8"/>
          <TextBlock x:Name="AudienceSummary" Foreground="#AFC5E4" TextWrapping="Wrap" Margin="0,0,0,7"/>
          <TextBlock Text="These defaults can be overridden by specific occurrences in later phases."
                     FontSize="12" Foreground="#AFC5E4" TextWrapping="Wrap" Margin="0,0,0,13"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Sort order" Foreground="#B9C9E4"/>
              <TextBox x:Name="SortBox"/>
            </StackPanel>
            <CheckBox x:Name="ActiveBox" Grid.Column="1" Content="Active"
                      VerticalAlignment="Center" IsChecked="True" Margin="4,0,0,0" Foreground="White"/>
          </Grid>
          <Separator Margin="0,7,0,13"/>
          <TextBlock Text="RELEVANT PERSONALITY TRAITS" FontWeight="Bold" FontSize="16" Margin="0,0,0,7"/>
          <TextBlock Text="Select which personality traits care about this memory type. Characters can still know a memory without caring about it. No relationships change here."
                     Foreground="#AFC5E4" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <Border Background="#202939" BorderBrush="#597090" BorderThickness="1" Padding="10" CornerRadius="4">
            <ScrollViewer Height="150" VerticalScrollBarVisibility="Auto">
              <WrapPanel x:Name="TraitPanel"/>
            </ScrollViewer>
          </Border>
          <TextBlock Text="Inactive traits are shown for maintenance; only active traits can be newly assigned."
                     Foreground="#AFC5E4" FontSize="12" Margin="0,8,0,10" TextWrapping="Wrap"/>
          <Button Content="Save memory type and personality relevance" Click="Save_Click"
                  FontWeight="Bold" HorizontalAlignment="Left" Margin="0,9,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
