<Window x:Class="SoulCaliberStudio.ChoiceMechanicsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choice Mechanics — Relationships and Skill Checks"
        Width="1060" Height="770" MinWidth="780" MinHeight="590"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource ForegroundBrush}">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="CHOICE MECHANICS" FontSize="22" FontWeight="Bold"/>
      <TextBlock x:Name="ChoiceHeading" FontSize="14" Foreground="#9EC5FF" Margin="0,3,0,0"/>
      <TextBlock Text="These rules apply to the selected choice for ANY two characters. All changes save to the master database; Godot reads the published content and evaluates these rules at runtime."
                 Foreground="#C4D0E1" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" MinWidth="100"/>
      <TextBlock x:Name="StatusText" Text="Select a record to edit, or choose New." Foreground="#B9C9E4"
                 TextWrapping="Wrap" VerticalAlignment="Center"/>
    </DockPanel>
    <TabControl x:Name="MechanicTabs" SelectionChanged="MechanicTabs_SelectionChanged">
      <TabItem Header="Relationship Effects">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Grid.Row="0">
            <TextBlock DockPanel.Dock="Top" Text="Changes applied AFTER the roll: success and failure may have different effects, in either direction."
                       TextWrapping="Wrap" Foreground="#B9C9E4" Margin="0,0,0,8"/>
            <ListBox x:Name="EffectList" SelectionChanged="EffectList_SelectionChanged"/>
          </DockPanel>
          <Border Grid.Row="1" Background="#242C39" CornerRadius="6" Padding="12" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock Text="EDIT EFFECT" FontWeight="Bold" Margin="0,0,0,8"/>
              <WrapPanel>
                <StackPanel Width="170" Margin="0,0,10,8">
                  <TextBlock Text="When" Foreground="#B9C9E4"/>
                  <ComboBox x:Name="EffectOutcomeBox" SelectionChanged="Editor_Changed"/>
                </StackPanel>
                <StackPanel Width="280" Margin="0,0,10,8">
                  <TextBlock Text="Whose feelings change?" Foreground="#B9C9E4"/>
                  <ComboBox x:Name="EffectDirectionBox" SelectionChanged="Editor_Changed"/>
                </StackPanel>
                <StackPanel Width="185" Margin="0,0,10,8">
                  <TextBlock Text="Relationship attribute" Foreground="#B9C9E4"/>
                  <ComboBox x:Name="EffectAttributeBox" SelectionChanged="Editor_Changed"/>
                </StackPanel>
                <StackPanel Width="105" Margin="0,0,10,8">
                  <TextBlock Text="Change (+ / -)" Foreground="#B9C9E4"/>
                  <TextBox x:Name="EffectDeltaBox" TextChanged="Editor_Changed"/>
                </StackPanel>
              </WrapPanel>
              <Button x:Name="MemoryEffectsButton" Click="EditMemoryEffects_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="44" Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Edit memory creation effects..." TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <Border x:Name="MemoryEffectsBadge" Grid.Column="1" CornerRadius="9" Padding="9,4" Background="#354151" VerticalAlignment="Center">
                    <TextBlock x:Name="MemoryEffectsCountText" Text="None" FontSize="11" FontWeight="SemiBold" Foreground="#C2CDDF"/>
                  </Border>
                </Grid>
              </Button>
              <Button x:Name="StatusEffectsButton" Click="EditStatusEffects_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="44" Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Edit Ally / Enemy status changes..." TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <Border x:Name="StatusEffectsBadge" Grid.Column="1" CornerRadius="9" Padding="9,4" Background="#354151" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusEffectsCountText" Text="None" FontSize="11" FontWeight="SemiBold" Foreground="#C2CDDF"/>
                  </Border>
                </Grid>
              </Button>
              <TextBlock Text="Example: SUCCESS · Recipient → Initiator · Fear · +15 means a successful threat makes its target fear the initiator more."
                         TextWrapping="Wrap" Foreground="#B9C9E4" FontSize="11" Margin="0,1,0,7"/>
              <WrapPanel>
                <Button Content="New effect" Click="NewEffect_Click"/>
                <Button Content="Save effect" Click="SaveEffect_Click"/>
                <Button Content="Delete selected" Click="DeleteEffect_Click"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Skill Check">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16,18" MaxWidth="820">
            <TextBlock Text="SKILL CHECK (ONE PER CHOICE)" FontWeight="Bold" FontSize="16"/>
            <TextBlock Text="A check adjusts the base success chance according to the initiator's personality and the recipient's resistance. If absent, only base chance and relationship modifiers apply."
                       Foreground="#B9C9E4" TextWrapping="Wrap" Margin="0,7,0,16"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,12,12">
                <TextBlock Text="Initiator's skill" Foreground="#B9C9E4"/>
                <ComboBox x:Name="SkillActorBox" SelectionChanged="Editor_Changed"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,0,12">
                <TextBlock Text="Recipient's defending skill" Foreground="#B9C9E4"/>
                <ComboBox x:Name="SkillDefenderBox" SelectionChanged="Editor_Changed"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="Relationship check profile" Foreground="#B9C9E4"/>
            <ComboBox x:Name="SkillModeBox" Margin="0,4,0,5" SelectionChanged="SkillMode_Changed"/>
            <WrapPanel Margin="0,0,0,12">
              <Button Content="Save profile for this choice" Click="SaveOptionProfile_Click"/>
              <Button Content="Manage / edit check profile formulas..." Click="EditCheckProfiles_Click"/>
            </WrapPanel>
            <TextBlock Text="The relationship profile applies to this choice even without a personality skill check. Skill checks separately add skill-versus-skill points."
                       Foreground="#B9C9E4" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,12,12">
                <TextBlock Text="Initiator factor" Foreground="#B9C9E4"/>
                <TextBox x:Name="SkillActorFactorBox" TextChanged="Editor_Changed"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,0,12">
                <TextBlock Text="Recipient factor" Foreground="#B9C9E4"/>
                <TextBox x:Name="SkillDefenderFactorBox" TextChanged="Editor_Changed"/>
              </StackPanel>
            </Grid>
            <Border Background="#151923" Padding="14" CornerRadius="6" Margin="0,4,0,12">
              <StackPanel>
                <TextBlock Text="HOW GODOT CALCULATES IT" FontWeight="Bold" Foreground="#9EC5FF"/>
                <TextBlock Text="Initiator bonus = (initiator skill − 50) × initiator factor" Foreground="#E7EDF8" Margin="0,6,0,2"/>
                <TextBlock Text="Recipient penalty = −(defender skill − 50) × recipient factor" Foreground="#E7EDF8"/>
                <TextBlock Text="Chosen profile formula (live from master database):" Foreground="#9EC5FF" Margin="0,10,0,4"/>
                <TextBlock x:Name="SkillProfileFormula" Foreground="#E7EDF8" TextWrapping="Wrap"/>
                <TextBlock Text="Final chance = clamp(round(base + profile terms + choice modifiers + initiator skill contribution − recipient skill contribution), 5, 95)."
                           TextWrapping="Wrap" Foreground="#B9C9E4" Margin="0,9,0,0"/>
              </StackPanel>
            </Border>
            <TextBlock x:Name="SkillStateText" Foreground="#B9C9E4" Margin="0,0,0,9"/>
            <WrapPanel>
              <Button Content="Save skill check" Click="SaveSkill_Click"/>
              <Button Content="Remove skill check" Click="DeleteSkill_Click"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Requirements">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock Text="All numeric, status and memory requirements must pass before a choice can be selected. Set below whether an unmet choice remains visibly locked or disappears entirely."
                         TextWrapping="Wrap" Foreground="#B9C9E4" Margin="0,0,0,6"/>
              <Button x:Name="AdvancedRequirementsButton" Click="EditMemoryRequirements_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="44" Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Advanced requirements — memory / status (AND / OR / NOT)..." TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <Border x:Name="AdvancedRequirementsBadge" Grid.Column="1" CornerRadius="9" Padding="9,4" Background="#354151" VerticalAlignment="Center">
                    <TextBlock x:Name="AdvancedRequirementsCountText" Text="None" FontSize="11" FontWeight="SemiBold" Foreground="#C2CDDF"/>
                  </Border>
                </Grid>
              </Button>
              <Button x:Name="SimpleRequirementsButton" Click="EditStatusRequirements_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="44" Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Simple relationship status requirements (AND only)..." TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <Border x:Name="SimpleRequirementsBadge" Grid.Column="1" CornerRadius="9" Padding="9,4" Background="#354151" VerticalAlignment="Center">
                    <TextBlock x:Name="SimpleRequirementsCountText" Text="None" FontSize="11" FontWeight="SemiBold" Foreground="#C2CDDF"/>
                  </Border>
                </Grid>
              </Button>
              <Border Background="#242C39" CornerRadius="6" Padding="10" Margin="0,10,0,8">
                <StackPanel>
                  <TextBlock Text="WHEN ANY REQUIREMENT IS NOT MET" FontWeight="Bold" Margin="0,0,0,5"/>
                  <WrapPanel>
                    <ComboBox x:Name="UnmetBehaviourBox" MinWidth="220" Width="250" Margin="0,0,10,0"
                              SelectionChanged="UnmetBehaviour_Changed"/>
                    <Button Content="Save choice visibility" Click="SaveChoiceVisibility_Click"/>
                  </WrapPanel>
                  <TextBlock Text="Show as locked is the default. Hide completely removes only this choice from the response list until its requirements are met. Applies to numeric, status and memory requirements."
                             Foreground="#B9C9E4" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <ListBox x:Name="RequirementList" SelectionChanged="RequirementList_SelectionChanged"/>
          </DockPanel>
          <Border Grid.Row="1" Background="#242C39" CornerRadius="6" Padding="12" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock Text="EDIT REQUIREMENT" FontWeight="Bold" Margin="0,0,0,8"/>
              <WrapPanel>
                <StackPanel Width="280" Margin="0,0,10,8">
                  <TextBlock Text="Relationship direction" Foreground="#B9C9E4"/>
                  <ComboBox x:Name="RequirementDirectionBox" SelectionChanged="Editor_Changed"/>
                </StackPanel>
                <StackPanel Width="175" Margin="0,0,10,8">
                  <TextBlock Text="Attribute" Foreground="#B9C9E4"/>
                  <ComboBox x:Name="RequirementAttributeBox" SelectionChanged="Editor_Changed"/>
                </StackPanel>
                <StackPanel Width="125" Margin="0,0,10,8">
                  <TextBlock Text="Minimum (optional)" Foreground="#B9C9E4"/>
                  <TextBox x:Name="RequirementMinBox" TextChanged="Editor_Changed"/>
                </StackPanel>
                <StackPanel Width="125" Margin="0,0,10,8">
                  <TextBlock Text="Maximum (optional)" Foreground="#B9C9E4"/>
                  <TextBox x:Name="RequirementMaxBox" TextChanged="Editor_Changed"/>
                </StackPanel>
              </WrapPanel>
              <TextBlock Text="Leave one bound empty if not needed. Each relationship attribute has its own editable minimum and maximum (see Relationship Attributes)."
                         TextWrapping="Wrap" Foreground="#B9C9E4" FontSize="11" Margin="0,1,0,7"/>
              <WrapPanel>
                <Button Content="New requirement" Click="NewRequirement_Click"/>
                <Button Content="Save requirement" Click="SaveRequirement_Click"/>
                <Button Content="Delete selected" Click="DeleteRequirement_Click"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Chance Modifiers">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Grid.Row="0">
            <TextBlock DockPanel.Dock="Top" Text="Fine-tune the chance of success using relationship values. This is in addition to the engine's standard relationship bonuses and the optional skill check."
                       TextWrapping="Wrap" Foreground="#B9C9E4" Margin="0,0,0,8"/>
            <ListBox x:Name="ModifierList" SelectionChanged="ModifierList_SelectionChanged"/>
          </DockPanel>
          <Border Grid.Row="1" Background="#242C39" CornerRadius="6" Padding="12" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock Text="EDIT CHANCE MODIFIER" FontWeight="Bold" Margin="0,0,0,8"/>
              <WrapPanel>
                <StackPanel Width="280" Margin="0,0,10,8">
                  <TextBlock Text="Relationship direction" Foreground="#B9C9E4"/>
                  <ComboBox x:Name="ModifierDirectionBox" SelectionChanged="Editor_Changed"/>
                </StackPanel>
                <StackPanel Width="180" Margin="0,0,10,8">
                  <TextBlock Text="Attribute" Foreground="#B9C9E4"/>
                  <ComboBox x:Name="ModifierAttributeBox" SelectionChanged="Editor_Changed"/>
                </StackPanel>
                <StackPanel Width="140" Margin="0,0,10,8">
                  <TextBlock Text="Factor (decimal)" Foreground="#B9C9E4"/>
                  <TextBox x:Name="ModifierFactorBox" TextChanged="Editor_Changed"/>
                </StackPanel>
              </WrapPanel>
              <TextBlock Text="Example: Recipient → Initiator Trust × 0.10: if Trust = 60, add 6 percentage points. Negative factors subtract points."
                         Foreground="#B9C9E4" TextWrapping="Wrap" FontSize="11" Margin="0,1,0,7"/>
              <WrapPanel>
                <Button Content="New modifier" Click="NewModifier_Click"/>
                <Button Content="Save modifier" Click="SaveModifier_Click"/>
                <Button Content="Delete selected" Click="DeleteModifier_Click"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
