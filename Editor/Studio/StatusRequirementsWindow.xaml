<Window x:Class="SoulCaliberStudio.StatusRequirementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dialogue choice — relationship status requirements"
        Width="820" Height="555" MinWidth="650" MinHeight="460" WindowStartupLocation="CenterOwner"
        Closing="Window_Closing"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource ForegroundBrush}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="RELATIONSHIP STATUS REQUIREMENTS" FontSize="20" FontWeight="Bold"/>
      <TextBlock Text="Lock this choice unless the current status matches the required Ally, Enemy, Neutral or custom status. Each requirement must pass. These checks do not change success probability."
                 Foreground="#B9C9E4" TextWrapping="Wrap" Margin="0,5,0,0"/>
      <Button Content="Open advanced AND / OR / NOT conditions..." Click="Advanced_Click"
              HorizontalAlignment="Left" Margin="0,9,0,0"/>
      <TextBlock Text="Advanced conditions can mix status and memory checks. These simple status requirements still apply with AND."
                 Foreground="#B9C9E4" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <TextBlock x:Name="StatusMessage" Text="Select a requirement or create a new one."
                 Foreground="#B9C9E4" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <WrapPanel>
        <Button Content="New requirement" Click="New_Click"/>
        <Button Content="Save requirement" Click="Save_Click"/>
        <Button Content="Delete selected" Click="Delete_Click"/>
        <Button Content="Close" Click="Close_Click" MinWidth="95"/>
      </WrapPanel>
    </StackPanel>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <ListBox x:Name="RequirementList" SelectionChanged="RequirementList_SelectionChanged"/>
      <Border Grid.Row="1" Background="#242C39" CornerRadius="6" Padding="12" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="EDIT STATUS REQUIREMENT" FontWeight="Bold" Margin="0,0,0,8"/>
          <WrapPanel>
            <StackPanel Width="290" Margin="0,0,10,8">
              <TextBlock Text="Relationship direction" Foreground="#B9C9E4"/>
              <ComboBox x:Name="DirectionBox" SelectionChanged="Editor_Changed"/>
            </StackPanel>
            <StackPanel Width="220" Margin="0,0,10,8">
              <TextBlock Text="Required status" Foreground="#B9C9E4"/>
              <ComboBox x:Name="StatusBox" DisplayMemberPath="Name" SelectedValuePath="Key"
                        SelectionChanged="Editor_Changed"/>
            </StackPanel>
          </WrapPanel>
          <TextBlock Text="Initiator → Recipient checks the initiator's view. Recipient → Initiator checks the recipient's view. Both directions requires BOTH characters to hold the selected status."
                     Foreground="#B9C9E4" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
