<Window x:Class="SoulCaliberStudio.InteractionSimulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoulCaliber Studio — Interaction Test Lab"
        Height="910" Width="1500" MinHeight="720" MinWidth="1100"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        FontFamily="Segoe UI" FontSize="13">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="INTERACTION TEST LAB" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="All simulated relationship values and outcomes exist in memory only. No changes to master content or player saves."
                 Foreground="#C4D7F3" Margin="0,3,0,12"/>
      <Border Background="#242C39" CornerRadius="7" Padding="12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="Initiator (left)" Foreground="#C4D7F3"/>
            <ComboBox x:Name="ActorBox" DisplayMemberPath="Name" Height="32"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,12,0">
            <TextBlock Text="Recipient (right)" Foreground="#C4D7F3"/>
            <ComboBox x:Name="PartnerBox" DisplayMemberPath="Name" Height="32"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="0,0,12,0">
            <TextBlock Text="Interaction type" Foreground="#C4D7F3"/>
            <ComboBox x:Name="InteractionBox" Height="32"/>
          </StackPanel>
          <Button Grid.Column="3" Content="Start / restart" Click="Start_Click" VerticalAlignment="Bottom" Height="34"/>
        </Grid>
      </Border>
    </StackPanel>

    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="375"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#242C39" Padding="12" CornerRadius="7" Margin="0,0,8,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="SIMULATED RELATIONSHIPS" FontWeight="Bold" FontSize="15"/>
            <TextBlock Text="Values start at 0. Edit either direction, then Start / restart. Forced outcomes modify only these values."
                       Foreground="#C4D7F3" FontSize="11" Margin="0,5,0,10" TextWrapping="Wrap"/>
            <TextBlock Text="Columns: initiator → recipient / recipient → initiator" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <Button Content="Re-evaluate dialogue and choices" Click="RefreshRules_Click" Margin="0,8,0,4"/>
            <Button Content="Reset all values to neutral (0)" Click="ResetValues_Click" Margin="0,2,0,4"/>
            <TextBlock Text="Fear and Romance are 0–100; other values are −100 to 100. The test never opens soulcaliber_savegame.db."
                       FontSize="11" Foreground="#C4D7F3" TextWrapping="Wrap"/>
          </StackPanel>
          <DataGrid x:Name="StatsGrid" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False"
                    CanUserDeleteRows="False" GridLinesVisibility="Horizontal" RowHeight="35" Background="#F8F9FC"
                    Foreground="#172033" AlternatingRowBackground="#EEF2F7" SelectionMode="Single" Margin="0,0,0,4">
            <DataGrid.Resources>
              <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#172033"/></Style>
              <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="#172033"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="CaretBrush" Value="#172033"/>
              </Style>
              <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="#172033"/></Style>
              <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#DFE8F3"/>
                <Setter Property="Foreground" Value="#172033"/>
                <Setter Property="FontWeight" Value="Bold"/>
              </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Attribute" Binding="{Binding Attribute}" IsReadOnly="True" Width="*"/>
              <DataGridTextColumn Header="A → B" Binding="{Binding ActorToPartner}" Width="75"/>
              <DataGridTextColumn Header="B → A" Binding="{Binding PartnerToActor}" Width="75"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" Margin="0,0,8,0">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#242C39" Padding="12" CornerRadius="7" Margin="0,0,0,8">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock Text="CURRENT DIALOGUE" FontSize="15" FontWeight="Bold"/>
              <TextBlock x:Name="NodeLabel" Foreground="#C4D7F3" Margin="0,4,0,4"/>
              <TextBlock x:Name="IntroductionSource" Foreground="#7FD2FF" TextWrapping="Wrap" FontSize="11"/>
            </StackPanel>
            <TextBox x:Name="IntroductionText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     FontSize="15" VerticalScrollBarVisibility="Auto"/>
          </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="#242C39" Padding="12" CornerRadius="7">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="AVAILABLE CHOICES" FontSize="15" FontWeight="Bold"/>
              <TextBlock Text="Locked choices remain visible. Select a choice, then force the outcome or roll normally."
                         FontSize="11" Foreground="#C4D7F3" TextWrapping="Wrap" Margin="0,4,0,6"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom">
              <WrapPanel Margin="0,7,0,0">
                <Button x:Name="ForceSuccessButton" Content="Force success" Click="ForceSuccess_Click"/>
                <Button x:Name="ForceFailureButton" Content="Force failure" Click="ForceFailure_Click"/>
                <Button x:Name="RollButton" Content="Random roll" Click="RandomRoll_Click"/>
              </WrapPanel>
              <Button x:Name="ContinueButton" Content="Next round / finish" Click="Continue_Click"/>
            </StackPanel>
            <ListBox x:Name="ChoiceList" SelectionChanged="ChoiceList_SelectionChanged"/>
          </DockPanel>
        </Border>
      </Grid>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#242C39" Padding="12" CornerRadius="7" Margin="0,0,0,8">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="LAST OUTCOME &amp; CHANGES" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBox x:Name="OutcomeText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
          </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="#242C39" Padding="12" CornerRadius="7">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="WHY WAS THIS DIALOGUE SELECTED?" FontSize="14" FontWeight="Bold"
                         VerticalAlignment="Center"/>
              <Button Content="Validate tree" Click="Validate_Click" Margin="12,0,0,0"/>
            </StackPanel>
            <TextBox x:Name="InspectorText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
