<Window x:Class="SoulCaliberStudio.InteractionSimulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoulCaliber Studio — Interaction Test Lab"
        Height="780" Width="1540" MinHeight="580" MinWidth="1190"
        WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        FontFamily="Segoe UI" FontSize="13">
  <!-- Fixed character selectors + interaction actions at the top; scrolling workspace below. -->
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock Text="INTERACTION TEST LAB" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="All simulated relationship values and outcomes exist in memory only. No changes to master content or player saves."
                 Foreground="#C4D7F3" Margin="0,3,0,12"/>
      <Border Background="#242C39" CornerRadius="7" Padding="12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="Initiator (left)" Foreground="#C4D7F3"/>
            <ComboBox x:Name="ActorBox" DisplayMemberPath="Name" Height="32"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,12,0">
            <TextBlock Text="Recipient (right)" Foreground="#C4D7F3"/>
            <ComboBox x:Name="PartnerBox" DisplayMemberPath="Name" Height="32"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="0,0,12,0">
            <TextBlock Text="Interaction type" Foreground="#C4D7F3"/>
            <ComboBox x:Name="InteractionBox" Height="32"/>
          </StackPanel>
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Button Content="Preview conversations" Click="PreviewConversations_Click" Height="34" Margin="0,0,7,0"/>
            <Button Content="Start / restart" Click="Start_Click" Height="34"/>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>

    <!-- Actions are directly below the character selectors so they cannot hide beneath the taskbar. -->
    <Border Grid.Row="1" Background="#242C39" CornerRadius="7"
            Padding="12" Margin="0,10,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="INTERACTION CONTROLS" FontWeight="Bold" FontSize="13"/>
          <TextBlock Text="Select a choice, resolve its outcome, then advance to the next round."
                     FontSize="11" Foreground="#C4D7F3" TextWrapping="Wrap"/>
        </StackPanel>
        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
          <Button x:Name="ForceSuccessButton" Content="Force success" Click="ForceSuccess_Click" Height="38"/>
          <Button x:Name="ForceFailureButton" Content="Force failure" Click="ForceFailure_Click" Height="38"/>
          <Button x:Name="RollButton" Content="Random roll" Click="RandomRoll_Click" Height="38"/>
        </WrapPanel>
        <Button Grid.Column="2" x:Name="ContinueButton" Content="Next round / finish"
                Click="Continue_Click" Height="40" MinWidth="166" Margin="12,0,0,0"
                VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- The three-column workspace alone scrolls below the persistent controls. -->
    <ScrollViewer Grid.Row="2" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly">
      <Grid Margin="0,4,0,0" Height="840">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="390"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#242C39" Padding="12" CornerRadius="7" Margin="0,0,8,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="SIMULATED CHARACTER STATE" FontWeight="Bold" FontSize="15"/>
            <TextBlock Text="All changes are temporary. Trait selections and relationship values never alter the master database or game save."
                       Foreground="#C4D7F3" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
          <TabControl RequestBringIntoView="PreventTabAutoScroll_RequestBringIntoView">
            <TabItem Header="Relationships">
              <DockPanel Margin="6,8,6,6">
                <StackPanel DockPanel.Dock="Top">
                  <TextBlock Text="Initiator → Recipient / Recipient → Initiator"
                             TextWrapping="Wrap" FontSize="11" Foreground="#C4D7F3" Margin="0,0,0,8"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                  <Button Content="Re-evaluate dialogue and choices" Click="RefreshRules_Click"/>
                  <Button Content="Reset relationships to defaults" Click="ResetValues_Click"/>
                  <TextBlock Text="Edit the two directions separately. Values use the ranges and defaults defined in Studio."
                             FontSize="11" Foreground="#C4D7F3" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <DataGrid x:Name="StatsGrid" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False"
                          CanUserDeleteRows="False" GridLinesVisibility="Horizontal" RowHeight="35" Background="#F8F9FC"
                          Foreground="#172033" AlternatingRowBackground="#EEF2F7" SelectionMode="Single" Margin="0,0,0,4">
                  <DataGrid.Resources>
                    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#172033"/></Style>
                    <Style TargetType="TextBox">
                      <Setter Property="Foreground" Value="#172033"/>
                      <Setter Property="Background" Value="White"/>
                      <Setter Property="CaretBrush" Value="#172033"/>
                    </Style>
                    <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="#172033"/></Style>
                    <Style TargetType="DataGridColumnHeader">
                      <Setter Property="Background" Value="#DFE8F3"/>
                      <Setter Property="Foreground" Value="#172033"/>
                      <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                  </DataGrid.Resources>
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Attribute" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="A → B" Binding="{Binding ActorToPartner}" Width="78"/>
                    <DataGridTextColumn Header="B → A" Binding="{Binding PartnerToActor}" Width="78"/>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </TabItem>
            <TabItem Header="Statuses">
              <StackPanel Margin="10,12,10,12">
                <TextBlock Text="Temporarily change directional Ally / Enemy / custom statuses. This never changes starting relationships or any savegame."
                           Foreground="#C4D7F3" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,15"/>
                <TextBlock x:Name="ActorStatusLabel" Text="Initiator → Recipient" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                <ComboBox x:Name="ActorStatusBox" DisplayMemberPath="Name" SelectedValuePath="Key" Height="32"
                          SelectionChanged="StatusSelection_Changed" Margin="0,0,0,15"/>
                <TextBlock x:Name="PartnerStatusLabel" Text="Recipient → Initiator" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                <ComboBox x:Name="PartnerStatusBox" DisplayMemberPath="Name" SelectedValuePath="Key" Height="32"
                          SelectionChanged="StatusSelection_Changed" Margin="0,0,0,15"/>
                <TextBlock x:Name="StatusDefaultsText" Foreground="#C4D7F3" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>
                <Button Content="Restore starting statuses" Click="RestoreStatuses_Click"/>
                <TextBlock Text="Changes take effect immediately in the choice list. Status effects from simulated outcomes carry over to subsequent rounds."
                           Foreground="#C4D7F3" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
              </StackPanel>
            </TabItem>
            <TabItem Header="Memories">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10,8,10,12">
                  <TextBlock Text="Historical occurrences are temporary. Quiet / Allies / Global knowledge uses the current simulated statuses."
                             FontSize="11" Foreground="#C4D7F3" TextWrapping="Wrap" Margin="0,0,0,8"/>
                  <TextBlock Text="Memory type"/>
                  <ComboBox x:Name="MemoryTypeBox" DisplayMemberPath="Name" Height="30" Margin="0,3,0,8"/>
                  <TextBlock Text="Affected character(s)"/>
                  <ComboBox x:Name="MemoryAffectedBox" Height="30" Margin="0,3,0,8"/>
                  <TextBlock Text="Severity"/>
                  <ComboBox x:Name="MemorySeverityBox" Height="30" Margin="0,3,0,8"/>
                  <TextBlock Text="Initial knowledge"/>
                  <ComboBox x:Name="MemoryKnowledgeBox" Height="30" Margin="0,3,0,8"/>
                  <Button Content="Record simulated memory" Click="AddMemory_Click" Margin="0,4,0,8"/>
                  <TextBlock Text="Recorded memories (select for details)" FontWeight="SemiBold"/>
                  <ListBox x:Name="MemoryHistoryBox" Height="120" SelectionChanged="MemoryHistory_SelectionChanged" Margin="0,5,0,7"/>
                  <TextBox x:Name="MemoryDetailsText" Height="105" IsReadOnly="True" TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
                  <TextBlock Text="Grant knowledge to" Margin="0,8,0,2"/>
                  <ComboBox x:Name="MemoryGrantBox" DisplayMemberPath="Name" Height="30"/>
                  <Button Content="Teach selected memory" Click="GrantMemoryKnowledge_Click" Margin="0,6,0,0"/>
                  <Button Content="Remove selected memory" Click="RemoveMemory_Click" Margin="0,5,0,0"/>
                  <Button Content="Clear memories + encounter completions" Click="ClearMemorySandbox_Click" Margin="0,5,0,0"/>
                  <TextBlock Text="Global memories are known by everyone. Removing an occurrence also removes its per-occurrence completions."
                             Foreground="#C4D7F3" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="Personality">
              <DockPanel Margin="9,8,9,9">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                  <TextBlock Text="Temporarily toggle traits for either character. Changes only affect relationship effects, not success chances."
                             Foreground="#C4D7F3" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Content="Restore original character traits" Click="RestoreTraits_Click" Margin="0,6,0,0"/>
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <GroupBox Grid.Row="0" Margin="0,0,0,6" Foreground="#F4F6FA">
                    <GroupBox.Header><TextBlock x:Name="ActorTraitLabel" Text="Initiator traits" Foreground="#F4F6FA"/></GroupBox.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <ItemsControl x:Name="ActorTraitsList">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Foreground="#F4F6FA" Margin="6,4" Checked="TraitSelection_Changed" Unchecked="TraitSelection_Changed"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </GroupBox>
                  <GroupBox Grid.Row="1" Foreground="#F4F6FA">
                    <GroupBox.Header><TextBlock x:Name="PartnerTraitLabel" Text="Recipient traits" Foreground="#F4F6FA"/></GroupBox.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <ItemsControl x:Name="PartnerTraitsList">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Foreground="#F4F6FA" Margin="6,4" Checked="TraitSelection_Changed" Unchecked="TraitSelection_Changed"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </GroupBox>
                </Grid>
              </DockPanel>
            </TabItem>
          </TabControl>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" Margin="0,0,8,0">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#242C39" Padding="12" CornerRadius="7" Margin="0,0,0,8">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock Text="CURRENT DIALOGUE" FontSize="15" FontWeight="Bold"/>
              <TextBlock x:Name="NodeLabel" Foreground="#C4D7F3" Margin="0,4,0,4"/>
              <TextBlock x:Name="IntroductionSource" Foreground="#7FD2FF" TextWrapping="Wrap" FontSize="11"/>
            </StackPanel>
            <TextBox x:Name="IntroductionText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     FontSize="15" VerticalScrollBarVisibility="Auto"/>
          </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="#242C39" Padding="12" CornerRadius="7">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="AVAILABLE CHOICES" FontSize="15" FontWeight="Bold"/>
              <TextBlock Text="Choices with unmet requirements are locked or hidden, as authored. The Choice gates tab lists all hidden choices."
                         FontSize="11" Foreground="#C4D7F3" TextWrapping="Wrap" Margin="0,4,0,6"/>
            </StackPanel>
            <ListBox x:Name="ChoiceList" SelectionChanged="ChoiceList_SelectionChanged"/>
          </DockPanel>
        </Border>
      </Grid>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="6*"/><RowDefinition Height="4*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#242C39" Padding="12" CornerRadius="7" Margin="0,0,0,8">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
              <TextBlock Text="LIVE SIX-STAGE MECHANICS AUDIT" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
              <Button Content="Copy audit" Click="CopyAudit_Click" Margin="12,0,0,0"/>
            </StackPanel>
            <TextBox x:Name="MechanicsText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontFamily="Consolas" FontSize="12"/>
          </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="#242C39" Padding="12" CornerRadius="7">
          <TabControl RequestBringIntoView="PreventTabAutoScroll_RequestBringIntoView">
            <TabItem Header="Last outcome">
              <DockPanel Margin="6,6,6,6">
                <TextBlock DockPanel.Dock="Top" Text="ROLLED OUTCOME &amp; APPLIED CHANGES" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBox x:Name="OutcomeText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
              </DockPanel>
            </TabItem>
            <TabItem Header="Choice gates">
              <DockPanel Margin="6,6,6,6">
                <TextBlock DockPanel.Dock="Top" Text="ALL CHOICES — REQUIREMENT CHECKS / HIDDEN OPTIONS"
                           FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBox x:Name="ChoiceAvailabilityText" IsReadOnly="True" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="11"/>
              </DockPanel>
            </TabItem>
            <TabItem Header="Encounters">
              <DockPanel Margin="6,6,6,6">
                <StackPanel DockPanel.Dock="Top">
                  <TextBlock Text="SIMULATED CONVERSATION AVAILABILITY" FontSize="13" FontWeight="Bold" Margin="0,0,0,5"/>
                  <TextBlock Text="Available / suppressed / ineligible. Select an eligible entry to launch its dialogue or simulate completion."
                             FontSize="11" Foreground="#C4D7F3" TextWrapping="Wrap" Margin="0,0,0,5"/>
                  <ListBox x:Name="EncounterList" Height="125" FontSize="11"/>
                  <WrapPanel Margin="0,4,0,5">
                    <Button Content="Start selected" Click="StartSelectedConversation_Click"/>
                    <Button Content="Mark special completed (test)" Click="CompleteSelectedEncounter_Click"/>
                    <Button Content="Clear completions" Click="ClearEncounterCompletions_Click"/>
                    <Button Content="Refresh" Click="RefreshEncounters_Click"/>
                  </WrapPanel>
                </StackPanel>
                <TextBox x:Name="EncounterAvailabilityText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
              </DockPanel>
            </TabItem>
            <TabItem Header="Dialogue inspector">
              <DockPanel Margin="6,6,6,6">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Text="DIALOGUE SELECTION &amp; VALIDATION" FontSize="13" FontWeight="Bold"
                             VerticalAlignment="Center"/>
                  <Button Content="Validate tree" Click="Validate_Click" Margin="12,0,0,0"/>
                </StackPanel>
                <TextBox x:Name="InspectorText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
              </DockPanel>
            </TabItem>
          </TabControl>
        </Border>
      </Grid>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
