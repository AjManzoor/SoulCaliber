<Application x:Class="SoulCaliberStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- Dark application surfaces. Text controls and dropdown menus use deliberate
         light surfaces with dark text; never force white onto every TextBlock. -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#151923"/>
    <SolidColorBrush x:Key="CardBrush" Color="#242C39"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#BCC9DC"/>
    <SolidColorBrush x:Key="InputTextBrush" Color="#172033"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#6FB6FF"/>

    <!-- MainWindow is a subclass of Window, so it also sets these explicitly. -->
    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- Important: no global TextBlock.Foreground override. TextBlocks inside light
         controls must inherit the control's DARK foreground instead of staying white. -->

    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Foreground" Value="#F7FAFF"/>
      <Setter Property="Background" Value="#364B68"/>
      <Setter Property="BorderBrush" Value="#617B9B"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#47668B"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#263B56"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#AFBBCB"/>
                <Setter TargetName="ButtonBorder" Property="Background" Value="#353C49"/>
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#495261"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource InputTextBrush}"/>
      <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="#8292A7"/>
      <Setter Property="CaretBrush" Value="{StaticResource InputTextBrush}"/>
      <Setter Property="SelectionBrush" Value="#A9CEFF"/>
      <Setter Property="SelectionTextBrush" Value="#172033"/>
      <Setter Property="Padding" Value="5,4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="#E4E8EF"/>
          <Setter Property="Foreground" Value="#465365"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- WPF's default ComboBox chrome is light; the text AND its popup items
         must therefore use a dark foreground. -->
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource InputTextBrush}"/>
      <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="#8292A7"/>
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="MinHeight" Value="29"/>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#172033"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="DropDownItem" Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="DropDownItem" Property="Background" Value="#D8E8FF"/>
                <Setter Property="Foreground" Value="#14213A"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="DropDownItem" Property="Background" Value="#BFD9FF"/>
                <Setter Property="Foreground" Value="#14213A"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#596778"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Consistent dark list boxes for interaction / node / phrase browsers. -->
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#1C2635"/>
      <Setter Property="Foreground" Value="#F6F8FD"/>
      <Setter Property="BorderBrush" Value="#50617A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="2"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#F6F8FD"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ListItemBorder" Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}" CornerRadius="3">
              <ContentPresenter VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ListItemBorder" Property="Background" Value="#35455D"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ListItemBorder" Property="Background" Value="#375F8F"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#9AA8BC"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Default Windows tab content area was white, although all our dialogue
         labels were white. Give header AND content a dark surface. -->
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="#1A2230"/>
      <Setter Property="Foreground" Value="#F4F6FA"/>
      <Setter Property="BorderBrush" Value="#43516A"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid KeyboardNavigation.TabNavigation="Local">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TabPanel x:Name="HeaderPanel" Grid.Row="0" IsItemsHost="True"
                        Panel.ZIndex="1" KeyboardNavigation.TabIndex="1"/>
              <Border Grid.Row="1" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1" CornerRadius="0,7,7,7" Padding="8">
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Background" Value="#222E40"/>
      <Setter Property="Foreground" Value="#D6E0F0"/>
      <Setter Property="BorderBrush" Value="#455873"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabHeader" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1,1,1,0" Margin="0,0,4,0"
                    Padding="{TemplateBinding Padding}" CornerRadius="6,6,0,0">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabHeader" Property="Background" Value="#1A2230"/>
                <Setter TargetName="TabHeader" Property="BorderBrush" Value="#75A9E7"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabHeader" Property="Background" Value="#324663"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#93A0B1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
